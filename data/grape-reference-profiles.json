[
  {
    "id": "aligote",
    "name": "Aligoté",
    "species": "Vitis vinifera",
    "color": {
      "en": "White",
      "zh": "白葡萄"
    },
    "country": {
      "en": "France",
      "zh": "法国"
    },
    "intro": {
      "en": "A Burgundian white Vitis vinifera variety with naturally high acidity, usually made as a dry wine. Expressions range from light, citrus-led whites to concentrated old-vine and single-vineyard wines with the structure to age. Site, yield and élevage are important to its expression.",
      "zh": "源自勃艮第的白葡萄品种，天然酸度高，通常酿成干白。风格从轻盈、以柑橘果味为主的白葡萄酒，到浓度较高、具陈年结构的老藤及单一葡萄园酒款。地块、产量与熟成方式对其表现有重要影响。"
    },
