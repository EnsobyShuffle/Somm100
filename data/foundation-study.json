      "number": 1,
      "title": "先学“怎么学葡萄酒”",
      "goal": "先理解葡萄酒学习不是背百科。",
      "checks": [
        {
          "id": "foundation-w1-check-1",
          "text": "我知道为什么先建立框架比先背产区更重要。"
        },
        {
          "id": "foundation-w1-check-2",
          "text": "我知道一瓶酒的风格不是凭空产生的。"
        },
        {
          "id": "foundation-w1-check-3",
          "text": "我知道后面会不断连接葡萄、产区、年份和酿造。"
        }
      ],
      "digest": "先把一瓶酒看成一组关系：葡萄品种提供风格的可能范围，产地与年份影响葡萄生长，种植和酿造选择继续改变结果。价格和酒庄名不能代替这些关系。遇到陌生概念，先问它在这条链条中做了什么。",
      "concepts": [
        "foundation-0",
        "foundation-1"
      ]
    },
    {
      "id": "foundation-week-2",
      "number": 2,
      "title": "从一颗葡萄开始",
      "goal": "认识葡萄本身和葡萄树一年怎么生长。",
      "checks": [
        {
          "id": "foundation-w2-check-1",
          "text": "我知道葡萄皮、果肉、籽、梗分别会影响什么。"
        },
        {
          "id": "foundation-w2-check-2",
          "text": "我能按顺序说出葡萄树主要生长阶段。"
        },
        {
          "id": "foundation-w2-check-3",
          "text": "我知道采收时间会影响成熟度。"
        }
      ],
      "digest": "果肉含有水、糖和酸；葡萄皮可提供颜色和单宁，籽和梗也可能影响单宁。葡萄树经历休眠、萌芽、开花、坐果、转色、成熟与采收。转色是成熟阶段的重要变化，采收时间会影响糖、酸和最后的风格。",
      "concepts": [
        "foundation-2"
      ]
    },
    {
      "id": "foundation-week-3",
      "number": 3,
      "title": "环境为什么会改变葡萄",
      "goal": "理解气候、阳光、水、坡度、海拔和土壤最终都在影响成熟。",
      "checks": [
        {
          "id": "foundation-w3-check-1",
          "text": "我知道温度、水、阳光会影响成熟。"
        },
        {
          "id": "foundation-w3-check-2",
          "text": "我知道年份不是简单的“好 / 坏年份表”。"
        },
        {
          "id": "foundation-w3-check-3",
          "text": "我知道种植者会主动管理葡萄园。"
        },
        {
          "id": "foundation-w3-check-4",
          "text": "我知道嫁接与砧木为什么重要。"
        }
      ],
      "digest": "温度、阳光、水分、地形和人的管理共同影响成熟。在其他条件相近时，冷凉环境通常更有利于保留酸度。土壤通过排水、保水、温度和根系环境影响生长，不能直接套用“某种土壤等于某种香气”。使用抗根瘤蚜砧木并嫁接欧洲葡萄品种，是应对根系危害的重要方法。",
      "concepts": [
        "foundation-2"
      ],
      "practices": [
        {"id": "foundation-vineyard-drainage", "title": "雨后积水与排水"},
        {"id": "foundation-vineyard-canopy", "title": "果串暴晒与叶幕"}
      ]
    },
    {
      "id": "foundation-week-4",
      "number": 4,
      "title": "葡萄怎么变成酒",
      "goal": "先理解发酵，再理解红、白、桃红基本差异。",
      "checks": [
        {
          "id": "foundation-w4-check-1",
          "text": "我能解释什么是酒精发酵。"
        },
        {
          "id": "foundation-w4-check-2",
          "text": "我知道红酒颜色主要来自果皮。"
        },
        {
          "id": "foundation-w4-check-3",
          "text": "我知道红葡萄也可以做白葡萄酒。"
        },
        {
          "id": "foundation-w4-check-4",
          "text": "我知道桃红为什么颜色更浅。"
        }
      ],
      "digest": "酒精发酵中，酵母利用糖，产生酒精、二氧化碳和热量。红葡萄酒通常与果皮接触发酵，获得颜色和单宁；白葡萄酒通常先把汁与皮分离，红葡萄也能用于酿白酒。许多桃红通过较短的果皮接触获得浅色，这并非所有桃红唯一的酿法。",
      "concepts": [
        "foundation-3"
      ],
      "practices": [
        {"id": "foundation-winemaking-fermentation-evidence", "title": "用记录核对发酵"}
      ]
    },
    {
      "id": "foundation-week-5",
      "number": 5,
      "title": "发酵之后，风格继续形成",
      "goal": "理解“酒精发酵结束，不等于葡萄酒已经完成”。",
      "checks": [
        {
          "id": "foundation-w5-check-1",
          "text": "我知道苹果酸乳酸转化为什么会改变酸感。"
        },
        {
          "id": "foundation-w5-check-2",
          "text": "我知道酒泥与质地有什么关系。"
        },
        {
          "id": "foundation-w5-check-3",
          "text": "我知道橡木桶不是“高级葡萄酒必需品”。"
        },
        {
          "id": "foundation-w5-check-4",
          "text": "我能说出酸度、单宁、酒体分别在描述什么。"
        }
      ],
      "digest": "苹果酸乳酸转化会把较尖锐的苹果酸转为较柔和的乳酸。酒泥陈酿可影响质地和复杂度；橡木可能影响香气、质地和熟成，不是高品质的必需条件。酸度描述酸感，甜度与残糖有关，单宁带来收敛感，酒体描述口中轻重饱满的感受。",
      "concepts": [
        "foundation-3",
        "foundation-4"
      ],
      "practices": [
        {"id": "foundation-winemaking-vessel-evidence", "title": "从熟成容器查木香"},
